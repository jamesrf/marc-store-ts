    "type-check": "tsc --noEmit"
  },
  "peerDependencies": {
    "marc-ts": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.0.0",
    "marc-ts": "file:../marc-ts",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0"
  }
}
