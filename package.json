{
  "name": "marc-store-ts",
  "version": "0.2.1",
  "description": "Lazy-parsing, copy-on-write storage and editing for large MARC21 files",
  "keywords": [
    "marc",
    "marc21",
    "marcxml",
    "library",
    "catalog",
    "bibliographic"
  ],
  "license": "MIT",
  "author": "James Fournie",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jamesrf/marc-store-ts.git"
  },
  "homepage": "https://github.com/jamesrf/marc-store-ts#readme",
  "bugs": {
    "url": "https://github.com/jamesrf/marc-store-ts/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "vite build",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:ui": "vitest --ui",
    "type-check": "tsc --noEmit && tsc -p tsconfig.examples.json",
    "lint": "eslint src examples bench",
    "lint:fix": "eslint src examples bench --fix",
    "format": "prettier --write \"src/**/*.ts\" \"examples/**/*.ts\" \"bench/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"examples/**/*.ts\" \"bench/**/*.ts\"",
    "prepublishOnly": "npm run type-check && npm run lint && npm test && npm run build",
    "examples": "bash scripts/run-examples.sh",
    "bench": "npm run build && node --experimental-strip-types bench/run.ts",
    "docs": "typedoc"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "marc-ts": "^0.4.5"
  },
  "dependencies": {
    "minisearch": "^7.2.0"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "@vitest/coverage-v8": "^4.1.12",
    "@vitest/ui": "^4.1.12",
    "esbuild": "^0.28.0",
    "eslint": "^10.4.0",
    "marc-ts": "^0.4.5",
    "prettier": "^3.9.4",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.0",
    "vite": "^8.0.13",
    "vite-plugin-dts": "^5.0.0",
    "vitest": "^4.1.12"
  }
}
